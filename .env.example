SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional dedicated secret for public opaque database IDs. If empty, a
# domain-separated key is derived from SECRET_KEY.
EXTERNAL_ID_SECRET=
# JSON list of retiring identifier secrets during a key rotation.
EXTERNAL_ID_PREVIOUS_SECRETS=[]
APP_ENV=development
DATABASE_URL=mysql+pymysql://happyenglish:password@127.0.0.1:3306/happy_english?charset=utf8mb4
COOKIE_SECURE=false
# Android app sessions stay valid for seven days; browser sessions keep the
# shorter SESSION_SECONDS lifetime unless the client identifies as Android.
APP_SESSION_SECONDS=604800
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Production example:
# APP_ENV=production
# COOKIE_SECURE=true
# CORS_ORIGINS=["https://happylingo.cn","https://www.happylingo.cn"]
# TRUSTED_HOSTS=["happylingo.cn","www.happylingo.cn","api.happylingo.cn","127.0.0.1","localhost"]
# API_DOCS_ENABLED=false
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
# Leave API_DOCS_ENABLED unset to enable documentation only outside production.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_CONSOLE=true
# Emit a warning when an API request takes at least this many milliseconds; set 0 to disable.
REQUEST_SLOW_MS=1000
AUDIO_ENABLED=false
# Optional AI-assisted review. Leave DEEPSEEK_API_KEY empty to use the
# deterministic selection fallback. The key stays on the server and is never
# sent to Android, the browser, logs, or review-session responses.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REVIEW_MODEL=deepseek-chat
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=20
DEEPSEEK_REVIEW_MAX_CANDIDATES=40
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_REQUEST_TIMEOUT_SECONDS=10
